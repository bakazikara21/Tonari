# server/.env の見本。これをコピーして server/.env を作る(.env は Git に入れない)
# Vertex AI の接続先
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# 使うモデル名
GEMINI_MODEL=gemini-3.8-flash
# 商品の埋め込みベクトルを作るモデル
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# お勧め機能: 利用者(ログイン機能はないので1人ぶんだけ設定する)
TONARI_USER_ID=user-001
# お勧め機能: データベースの場所(省略すると server/data/tonari.db)
# TONARI_DB_PATH=data/tonari.db
