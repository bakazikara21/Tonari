{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "Tonari",
      "target-membership": [
        "Tonari",
      ],
      "membership-exceptions": [
        {
          "target": "Tonari",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "TonariTests", "target-membership": [ "TonariTests" ] },
    { "kind": "folder", "path": "TonariUITests", "target-membership": [ "TonariUITests" ] },
    {
      "kind": "folder",
      "path": "Tonari Extension",
      "opaque-folders": [
        "Resources/_locales",
        "Resources/images",
      ],
      "target-membership": [
        "Tonari Extension",
      ],
      "membership-exceptions": [
        {
          "target": "Tonari Extension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Tonari.app", "id": "5CDCEC5D30A96C65004C0AF7", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TonariTests.xctest", "id": "5CDCEC7A30A96C67004C0AF7", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/TonariUITests.xctest", "id": "5CDCEC8430A96C67004C0AF7", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/Tonari Extension.appex", "id": "5CDCEC8E30A96C67004C0AF7", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Tonari/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Tonari",
      "id": "5CDCEC5C30A96C65004C0AF7",
      "product": "Products/Tonari.app",
      "product-type": "application",
      "dependencies": [
        "Tonari Extension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "LUT83894F3",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Tonari/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Tonari",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchStoryboardName": "LaunchScreen",
        "INFOPLIST_KEY_UIMainStoryboardFile": "Main",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "OTHER_LDFLAGS": [
          "-framework",
          "SafariServices",
          "-framework",
          "WebKit",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "io.github.bakazikara21.Tonari",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "TonariTests",
      "id": "5CDCEC7930A96C67004C0AF7",
      "product": "Products/TonariTests.xctest",
