<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 写真の選択メニューなど、iOS が出す画面を日本語で表示するため -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 開発中は Mac の中継サーバー(http://localhost や http://○○.local)を表示するため、ローカルだけ http を許可する -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 実機で、同じ Wi-Fi にある Mac の中継サーバーにつなぐときに iOS が出す確認の文 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>おすすめや案内を表示するために、同じ Wi-Fi にあるパソコンにつなぎます。</string>
</dict>
</plist>
